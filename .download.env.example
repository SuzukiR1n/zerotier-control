# Optional: copy to .download.env, or run bash deploy.sh downloads.
# Use docker.io for official Docker Hub. The registry also applies to FROM images.
DOCKER_REGISTRY=docker.io
# auto = public mirrors, none = this registry only, or comma-separated hostnames.
DOCKER_REGISTRY_FALLBACKS=none
# HTTPS URL prefix for public GitHub source downloads and git pull; blank = direct.
GITHUB_PROXY=
