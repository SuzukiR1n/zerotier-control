# Linux 主机上已经安装 zerotier-one 的默认部署方式
ZT_API_URL=http://127.0.0.1:9993
ZT_TOKEN_PATH=/var/lib/zerotier-one/authtoken.secret
ADMIN_PASSWORD_PATH=./secrets/admin-password
PUBLIC_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
# 接入原 docker-zerotier-planet 项目时使用 deploy/compose.planet.yaml
ZT_CONTAINER_NAME=myztplanet
ZT_PORT=9994
# 将 ZT_TOKEN_PATH 改为旧项目 data/zerotier/one/authtoken.secret 的绝对路径
